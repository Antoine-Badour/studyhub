{
  "name": "studyspace-personal-learning",
  "version": "1.0.0",
  "private": true,
  "description": "A personal learning workspace with isolated accounts, durable Supabase storage, and Gemini tutoring.",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node test/smoke.js",
    "test:supabase": "node test/supabase-smoke.js",
    "db:check": "node scripts/check-supabase.js",
    "db:verify": "node scripts/verify-supabase-migration.js",
    "db:migrate": "node scripts/migrate-to-supabase.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@google/genai": "^1.11.0",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "postgres": "^4.1.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
