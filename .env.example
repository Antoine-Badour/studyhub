# Optional until you want to use AI features. Never commit your real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
# Supabase Postgres connection URI (server-only; never use a public frontend variable)
DATABASE_URL=
# Required in production before the first account is created; use a long random secret.
STUDYSPACE_SETUP_TOKEN=

# Backblaze B2 S3-compatible storage (create a private bucket and bucket-scoped app key)
B2_BUCKET_NAME=
B2_REGION=
B2_ENDPOINT=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
